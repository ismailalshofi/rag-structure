APP_NAME="rag-structure"
APP_VERSION="1.0"

# ---------- Vector database: memory | chroma | qdrant | pgvector ----------
VECTOR_DB="chroma"
# chroma: a folder, no server needed
CHROMA_PATH="data/chroma"
# qdrant: ":memory:", a server ("http://localhost:6333") or Qdrant Cloud (+ QDRANT_API_KEY)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=
# pgvector: any Postgres with the vector extension
PGVECTOR_URL="postgresql://postgres:postgres@localhost:5432/rag"

# ---------- Embeddings: fastembed (local, free) | openai (any OpenAI-compatible API) ----------
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
# Only for EMBEDDING_PROVIDER="openai", e.g. EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---------- LLM: any OpenAI-compatible chat API (OpenRouter by default) ----------
LLM_API_KEY=
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="openai/gpt-4o-mini"

# ---------- Retrieval ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SCORE=0.55
MEMORY_TURNS=6

# ---------- Upload ----------
FILE_MAX_SIZE=10485760
FILE_CHUNK_SIZE=512000
